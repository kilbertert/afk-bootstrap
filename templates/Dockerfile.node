# AFK sandbox image for a Node.js project.
# node 24 matches most Node projects' engines; bookworm keeps a stable libc.
FROM node:24-bookworm

ARG AGENT_UID=1000
ARG AGENT_GID=1000

RUN apt-get update \
  && apt-get install -y --no-install-recommends git curl jq ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# If your test suite launches a real browser (e.g. Playwright), bake the
# browser + OS deps in so the agent can self-verify inside the container
# instead of reporting a false BLOCKED. Keep the version in sync with your
# @playwright/test and add `ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright`
# before USER below.
# RUN PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright npx --yes playwright@1.62.0 install --with-deps chromium \
#   && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list >/dev/null \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

RUN groupmod -o -g ${AGENT_GID} node \
  && usermod -o -u ${AGENT_UID} -g ${AGENT_GID} -d /home/agent -m -l agent node \
  && mkdir -p /home/agent/.codex && chown -R ${AGENT_UID}:${AGENT_GID} /home/agent/.codex

# Serena MCP server — symbol-level code navigation (LSP-backed). Baked in
# rather than installed per run: it is ~107 MB and takes 30-60 s to install, and
# pinning it keeps every project's AFK run on the same version.
#
# Paths come from env vars, not flags: `uv tool install` has no --home or
# --install-dir option (verified against uv 0.12), and this RUN sits above the
# `USER` line — a bare install would land in /root/.local/bin, where the agent
# cannot read it. UV_TOOL_BIN_DIR puts the shim in a directory everyone
# resolves; UV_TOOL_DIR keeps the venv under the agent's home so the chown
# below can hand the whole tree over.
RUN UV_TOOL_BIN_DIR=/usr/local/bin UV_TOOL_DIR=/home/agent/.local/share/uv/tools \
      uv tool install serena-agent==1.7.0 \
  && chown -R ${AGENT_UID}:${AGENT_GID} /home/agent/.local \
  && serena --version

# --allow-scripts is required, not decorative: npm 11 refuses to run a package's
# postinstall unless it is named, and claude-code's postinstall (install.cjs) is
# what fetches its platform-native binary. Without it npm only WARNS, the build
# still exits 0, and the container starts with a claude that reports
# "claude native binary not installed" — a green build around a broken image.
# (Measured: the same Dockerfile produced a working build once and a broken one
# the next time, so the failure is intermittent and cannot be waited out.)
RUN npm install --global --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code \
  && npm install --global @openai/codex@0.146.1 \
  && mv /usr/local/bin/claude /usr/local/bin/claude-real \
  && printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -eu' \
    'case "${AFK_PROFILE:-claude}" in' \
    '  claude) exec /usr/local/bin/claude-real "$@" ;;' \
    '  claude-deepseek) args=(); while [ "$#" -gt 0 ]; do if [ "$1" = "--model" ]; then shift 2; else args+=("$1"); shift; fi; done; exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u ANTHROPIC_MODEL -u ANTHROPIC_REASONING_MODEL -u ANTHROPIC_DEFAULT_OPUS_MODEL -u ANTHROPIC_DEFAULT_SONNET_MODEL -u ANTHROPIC_DEFAULT_HAIKU_MODEL CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1 /usr/local/bin/claude-real --settings /home/agent/.afk-profile-settings.json --mcp-config /home/agent/.afk-mcp.json "${args[@]}" ;;' \
    '  *) echo "unsupported AFK_PROFILE" >&2; exit 2 ;;' \
    'esac' > /usr/local/bin/claude \
  && chmod 755 /usr/local/bin/claude \
  && npm cache clean --force

USER ${AGENT_UID}:${AGENT_GID}
WORKDIR /home/agent
ENTRYPOINT ["sleep", "infinity"]
